[connection]
id=usb0-default
type=ethernet
autoconnect-priority=-980
interface-name=usb0
permissions=

[ethernet]
mac-address-blacklist=

[ipv4]
method=auto
# self-assign the PlanktoScope-associated IP address so that it's available for interface forwarding
# of inbound packets even if the upstream network router dynamically assigns an IP address:
address1=192.168.6.1/24
dhcp-timeout=5
may-fail=false
dns-search=

[ipv6]
addr-gen-mode=stable-privacy
dns-search=
method=auto

[proxy]

