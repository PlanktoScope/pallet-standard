[connection]
id=usb0-default
type=ethernet
autoconnect-priority=-980
interface-name=usb0
permissions=

[ethernet]
mac-address-blacklist=

[ipv4]
method=auto
# note: we don't try to self-assign 192.168.6.1, because it seems to cause problems.
dns-search=

[ipv6]
addr-gen-mode=stable-privacy
dns-search=
method=auto

[proxy]

