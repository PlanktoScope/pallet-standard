#!/usr/bin/bash -eu

redirect_inbound() {
  local ipaddr="$1"

  iptables -t nat -A PREROUTING -d "$ipaddr" -j DNAT --to-destination 127.0.0.1
}

# Redirect external incoming traffic bound for the device's static IP addresses to 127.0.0.1
redirect_inbound 192.168.3.1
redirect_inbound 192.168.4.1
redirect_inbound 192.168.5.1
redirect_inbound 192.168.6.1
redirect_inbound 192.168.7.1
